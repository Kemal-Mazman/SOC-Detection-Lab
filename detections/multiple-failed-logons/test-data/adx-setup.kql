// ============================================================================
// ADX free-cluster setup for Detection 1 (Multiple Failed Logons)
// Run these in order in the Azure Data Explorer web UI (dataexplorer.azure.com,
// "My Cluster"). No Azure subscription required — Microsoft account only.
//
// This creates a table named SecurityEvent with the subset of columns the
// detection needs, so ../detection.kql runs UNCHANGED here and in real Sentinel.
// ============================================================================

// --- Step 1: create the mirror table -------------------------------------
.create table SecurityEvent (
    TimeGenerated: datetime,
    EventID: int,
    Account: string,
    Computer: string,
    IpAddress: string,
    LogonType: int
)

// --- Step 2: ingest the sample events ------------------------------------
// Option A (used here): paste the CSV rows inline. The `ingestionMapping` skips
// the header row via `with (ignoreFirstRecord=true)`.
// Option B: upload sample-4625-events.csv via the "Ingest data" wizard instead.

.ingest inline into table SecurityEvent with (ignoreFirstRecord=true) <|
TimeGenerated,EventID,Account,Computer,IpAddress,LogonType
